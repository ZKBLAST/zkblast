# Elysium testnet uses the shared ZKBLAST service environment with an isolated
# chain ID, manifest, database schema, and indexer cursor. Keep every value
# blank in the tracked template and set actual values only in ignored/local or
# deployment-secret configuration.
APP_ENV=
CHAIN_ID=
CHAIN_NAME=
RPC_URL=
ELYSIUM_PRIVATE_RPC_URL=
ELYSIUM_WS_RPC_URL=
ELYSIUM_INDEXER_RPC_RANGE_DELAY_MS=
BLOCK_EXPLORER_URL=
DEPLOYMENT_MANIFEST_PATH=

API_PORT=
WEB_ORIGIN=
NEXT_PUBLIC_API_URL=
API_URL=
ENABLE_ELYSIUM_TESTNET=
ELYSIUM_TESTNET_WEB_URL=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DIRECT_DATABASE_URL=
SUPABASE_SCHEMA=
CONFIRM_ELYSIUM_TESTNET_SCHEMA_WRITE=

INDEXER_CONFIRMATIONS=
INDEXER_POLL_INTERVAL_MS=
INDEXER_BATCH_SIZE=
INDEXER_CATCHUP_CHUNK_SIZE=
INDEXER_CATCHUP_MAX_BLOCKS=
INDEXER_RPC_RANGE_DELAY_MS=

# Server signing values remain empty and must never use NEXT_PUBLIC_ prefixes.
DEPLOYER_PRIVATE_KEY=
GOVERNANCE_PRIVATE_KEY=
UPGRADER_PRIVATE_KEY=
ELYSIUM_DEPLOYER_ADDRESS=
ELYSIUM_GOVERNANCE_ADDRESS=
ELYSIUM_UPGRADER_ADDRESS=
ELYSIUM_PAUSER_ADDRESS=
ELYSIUM_KEEPER_ADDRESS=
ELYSIUM_FEE_RECIPIENT_ADDRESS=
ELYSIUM_RELAYER_ADDRESS=
ELYSIUM_ATTESTOR_ADDRESS=

# Shared testnet credentials are loaded from the ignored .env.testnet file.
# Keep this overlay limited to Elysium-specific public/runtime configuration.
OPERATIONS_API_TOKEN=
LAUNCHPAD_WEBHOOK_ENCRYPTION_KEY=

# Canonical assets and integration addresses are populated only after exact
# chain/address/provenance validation and the corresponding capability gate.
EXECUTION_WHYPE_ADDRESS=
EXECUTION_USDC_ADDRESS=
EXECUTION_RESERVE_ASSET_ADDRESS=
GRADUATION_POOL_FACTORY_ADDRESS=
GRADUATION_SWAP_ROUTER_ADDRESS=
