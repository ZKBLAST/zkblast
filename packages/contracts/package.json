{
  "name": "@zkblast/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "forge build",
    "test": "forge test",
    "lint": "solhint 'src/**/*.sol'",
    "typecheck": "tsc --noEmit",
    "check:artifacts": "node --experimental-strip-types scripts/check-deployment-artifacts.ts",
    "preflight:deploy": "node --experimental-strip-types scripts/preflight-deployment.ts",
    "recover:aborted": "node --experimental-strip-types scripts/recover-aborted-deployment.ts",
    "upgrade": "node --experimental-strip-types scripts/upgrade-protocol.ts",
    "storage:snapshot": "node --experimental-strip-types scripts/storage-layout.ts --write",
    "storage:check": "node --experimental-strip-types scripts/storage-layout.ts",
    "deploy": "node --experimental-strip-types scripts/deploy-protocol.ts",
    "check:mainnet-release-gates": "node --experimental-strip-types scripts/deploy-protocol.ts --check-only",
    "rehearse:mainnet-deployment": "node --experimental-strip-types scripts/deploy-protocol.ts --rehearsal",
    "deploy:testnet-market": "node --experimental-strip-types scripts/deploy-testnet-market.ts",
    "deploy:testnet-withdraw-verifier": "node --experimental-strip-types scripts/deploy-testnet-withdraw-verifier.ts",
    "deploy:testnet-vault": "node --experimental-strip-types scripts/deploy-testnet-vault.ts",
    "deploy:testnet-withdrawal": "node --experimental-strip-types scripts/deploy-testnet-withdrawal.ts",
    "deploy:mainnet-safe": "node --experimental-strip-types scripts/deploy-mainnet-safe.ts",
    "deploy:mainnet-timelock": "node --experimental-strip-types scripts/deploy-mainnet-timelock.ts",
    "plan:mainnet-deployment": "node --experimental-strip-types scripts/prepare-mainnet-deployment.ts",
    "configure:testnet-shielded-usdg": "node --experimental-strip-types scripts/configure-testnet-shielded-usdg.ts",
    "accept:testnet-liquidity": "node --experimental-strip-types scripts/accept-testnet-liquidity.ts",
    "verify:testnet-market": "node --experimental-strip-types scripts/verify-testnet-market.ts",
    "seed:testnet-external-markets": "node --experimental-strip-types scripts/seed-external-market-pools.ts",
    "verify:manifest": "node --import tsx scripts/verify-manifest.ts",
    "verify:mainnet-rehearsal": "node --import tsx scripts/verify-manifest.ts --rehearsal",
    "audit:deployment": "node --import tsx scripts/audit-deployment.ts"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.7.0",
    "@safe-global/safe-deployments": "1.37.58",
    "@zkblast/config": "workspace:*",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
