{
  "name": "@zkblast/indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/runner.ts",
    "build": "tsup",
    "start": "node dist/runner.js",
    "sync:charts": "node --import tsx src/run-market-chart-sync.ts",
    "backfill:testnet-market": "node --import tsx src/backfill-testnet-market.ts",
    "backfill:testnet-shielded": "node --import tsx src/backfill-testnet-shielded.ts",
    "sync:external-markets": "node --import tsx src/sync-external-markets.ts",
    "sync:external-market-swaps": "node --import tsx src/sync-external-market-swaps.ts",
    "sync:external-market-oracles": "node --import tsx src/sync-external-market-oracles.ts",
    "markets:curate": "node --import tsx src/curate-external-markets.ts",
    "markets:curate:validate": "node --import tsx src/curate-external-markets.ts validate",
    "markets:curate:pons-logos": "node --import tsx src/curate-pons-logos.ts",
    "markets:update:quote-logos": "node --import tsx src/update-quote-asset-logos.ts",
    "sync:external-market-pairs": "node --import tsx src/sync-external-market-pairs.ts",
    "map:testnet-market-tokens": "node --import tsx src/map-testnet-market-tokens.ts",
    "discover:testnet-market-routes": "node --import tsx src/discover-testnet-market-routes.ts",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@zkblast/abi": "workspace:*",
    "@zkblast/config": "workspace:*",
    "@zkblast/database": "workspace:*",
    "@zkblast/observability": "workspace:*",
    "postgres": "^3.4.5",
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  }
}
