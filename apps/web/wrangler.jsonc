{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zkblast",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "zkblast.tech/*",
      "zone_name": "zkblast.tech"
    },
    {
      "pattern": "www.zkblast.tech/*",
      "zone_name": "zkblast.tech"
    }
  ],
  "vars": {
    "API_URL": "https://api.zkblast.tech",
    "NEXT_PUBLIC_API_URL": "https://api.zkblast.tech",
    "ZKBLAST_CA": "0x3f9ff9f1d40369f99c281375bd19d6ecbebfecd7"
  }
}
