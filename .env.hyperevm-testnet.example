# HyperEVM testnet (chain 998). Copy locally and keep the populated file untracked.
APP_ENV=testnet
CHAIN_ID=998
CHAIN_NAME=HyperEVM Testnet
RPC_URL=https://rpc.hyperliquid-testnet.xyz/evm
# Optional comma-separated server-only fallbacks. Validate each provider before enabling.
RPC_FALLBACK_URLS=
# The official RPC is polled; do not copy a Robinhood WebSocket endpoint here.
WS_RPC_URL=
# Set only after selecting and validating a testnet explorer.
BLOCK_EXPLORER_URL=
DEPLOYMENT_MANIFEST_PATH=deployments/hyperevm-testnet/manifest.json
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
INDEXER_CONFIRMATIONS=
INDEXER_POLL_INTERVAL_MS=1000
INDEXER_BATCH_SIZE=20
INDEXER_CATCHUP_CHUNK_SIZE=50
ALERT_RPC_LAG_BLOCKS=25
ALERT_CHECKPOINT_AGE_SECONDS=120
ALERT_TRANSACTION_FAILURES=3
ALERT_RECEIPT_FAILURES=5
OPERATIONS_API_TOKEN=
LAUNCHPAD_WEBHOOK_ENCRYPTION_KEY=

# Browser-safe values only.
NEXT_PUBLIC_API_URL=
API_URL=

# Use a distinct HyperEVM project/schema. Never reuse Robinhood schemas.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DIRECT_DATABASE_URL=
SUPABASE_SCHEMA=zkblast_hyperevm_testnet

# Server-side only. Leave empty until an approved deployment preflight.
DEPLOYER_PRIVATE_KEY=
GOVERNANCE_PRIVATE_KEY=
UPGRADER_PRIVATE_KEY=
# Read-only planning uses explicit public addresses and never derives them from keys.
HYPEREVM_DEPLOYER_ADDRESS=
GOVERNANCE_MULTISIG_ADDRESS=
HYPEREVM_UPGRADER_ADDRESS=
HYPEREVM_KEEPER_ADDRESS=
HYPEREVM_RELAYER_ADDRESS=
HYPEREVM_FEE_RECIPIENT_ADDRESS=
MIN_TIMELOCK_DELAY_SECONDS=

# Preflight-only candidate. This does not enable the runtime capability.
HYPEREVM_RESERVE_ASSET_ADDRESS=0x5555555555555555555555555555555555555555

# Remain empty until P204 validates real chain-998 assets/adapters.
EXECUTION_RESERVE_ASSET_ADDRESS=
GRADUATION_POOL_FACTORY_ADDRESS=
GRADUATION_SWAP_ROUTER_ADDRESS=
