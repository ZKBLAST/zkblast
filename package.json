{
  "name": "zkblast",
  "version": "0.1.0",
  "private": true,
  "description": "Zero-Knowledge Liquidity Infrastructure",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:testnet": "dotenv -e .env.testnet -- turbo run dev",
    "dev:mainnet": "dotenv -e .env.mainnet -- turbo run dev",
    "dev:web:testnet": "dotenv -e .env.testnet -- turbo run dev --filter=@zkblast/web",
    "dev:web:mainnet": "dotenv -e .env.mainnet -- turbo run dev --filter=@zkblast/web",
    "dev:api:testnet": "dotenv -e .env.testnet -- turbo run dev --filter=@zkblast/api",
    "dev:indexer:testnet": "dotenv -e .env.testnet -- turbo run dev --filter=@zkblast/indexer",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check:brand": "node scripts/check-brand.mjs",
    "check:env:testnet": "APP_ENV=testnet node scripts/check-env.mjs",
    "check:env:mainnet": "APP_ENV=mainnet node scripts/check-env.mjs",
    "check:env:security": "node scripts/check-env-security.mjs",
    "check:web:architecture": "node scripts/check-web-architecture.mjs",
    "check:protocol:vectors": "node scripts/validate-protocol-regression-vectors.mjs",
    "check:network:testnet": "dotenv -e .env.testnet -- node scripts/check-network.mjs",
    "check:network:mainnet": "dotenv -e .env.mainnet -- node scripts/check-network.mjs",
    "check:mainnet:readiness": "dotenv -e .env.mainnet -- node scripts/check-mainnet-readiness.mjs",
    "configure:mainnet:from-testnet": "node scripts/configure-mainnet-from-testnet.mjs",
    "configure:operations-tokens": "node scripts/ensure-operations-tokens.mjs",
    "contracts:deploy:testnet": "dotenv -e .env.testnet -- pnpm --filter @zkblast/contracts run deploy",
    "contracts:deploy:mainnet": "dotenv -e .env.mainnet -- pnpm --filter @zkblast/contracts run deploy",
    "contracts:verify:testnet": "dotenv -e .env.testnet -- pnpm --filter @zkblast/contracts run verify:manifest",
    "contracts:accept:testnet-liquidity": "dotenv -e .env.testnet -- pnpm --filter @zkblast/contracts run accept:testnet-liquidity",
    "contracts:deploy:testnet-withdraw-verifier": "dotenv -e .env.testnet -- pnpm --filter @zkblast/contracts run deploy:testnet-withdraw-verifier",
    "contracts:deploy:testnet-vault": "dotenv -e .env.testnet -- pnpm --filter @zkblast/contracts run deploy:testnet-vault",
    "contracts:deploy:testnet-withdrawal": "dotenv -e .env.testnet -- pnpm --filter @zkblast/contracts run deploy:testnet-withdrawal",
    "contracts:verify:mainnet": "dotenv -e .env.mainnet -- pnpm --filter @zkblast/contracts run verify:manifest",
    "contracts:audit:testnet": "dotenv -e .env.testnet -- pnpm --filter @zkblast/contracts run audit:deployment",
    "contracts:audit:mainnet": "dotenv -e .env.mainnet -- pnpm --filter @zkblast/contracts run audit:deployment",
    "contracts:check:artifacts": "pnpm --filter @zkblast/contracts run check:artifacts",
    "contracts:preflight:testnet": "dotenv -e .env.testnet -- pnpm --filter @zkblast/contracts run preflight:deploy",
    "contracts:preflight:mainnet": "dotenv -e .env.mainnet -- pnpm --filter @zkblast/contracts run preflight:deploy",
    "contracts:recover:aborted:testnet": "dotenv -e .env.testnet -- pnpm --filter @zkblast/contracts run recover:aborted",
    "contracts:storage:snapshot": "pnpm --filter @zkblast/contracts run storage:snapshot",
    "contracts:storage:check": "pnpm --filter @zkblast/contracts run storage:check",
    "contracts:upgrade:factory:testnet": "dotenv -e .env.testnet -- env UPGRADE_CONTRACT_NAME=PoolFactory pnpm --filter @zkblast/contracts run upgrade",
    "abi:generate": "pnpm --filter @zkblast/abi run generate",
    "abi:check": "pnpm --filter @zkblast/abi run check:generated",
    "sync:ws:testnet": "node scripts/sync-alchemy-ws.mjs .env.testnet",
    "db:generate:identity": "node scripts/generate-identity-migrations.mjs",
    "db:generate:auth": "node scripts/generate-auth-session-migrations.mjs",
    "db:generate:protocol": "node scripts/generate-protocol-migrations.mjs",
    "db:migrate:testnet": "dotenv -e .env.testnet -- node scripts/migrate-database.mjs apply",
    "db:verify:testnet": "dotenv -e .env.testnet -- node scripts/migrate-database.mjs verify",
    "db:migrate:mainnet": "dotenv -e .env.mainnet -- node scripts/migrate-database.mjs apply",
    "db:verify:mainnet": "dotenv -e .env.mainnet -- node scripts/migrate-database.mjs verify",
    "db:register:testnet-market": "dotenv -e .env.testnet -- node scripts/register-testnet-market.mjs",
    "db:seed:testnet": "dotenv -e .env.testnet -- node scripts/register-testnet-market.mjs",
    "db:seed:mainnet": "node scripts/refuse-database-seed.mjs mainnet",
    "check:db:seed-policy": "node scripts/check-database-seed-policy.mjs",
    "markets:sync:testnet": "dotenv -e .env.testnet -- pnpm --filter @zkblast/indexer run sync:external-markets",
    "markets:sync:stocks:testnet": "dotenv -e .env.testnet -- env MARKET_SYNC_SCOPE=stocks pnpm --filter @zkblast/indexer run sync:external-markets",
    "markets:sync:pons:testnet": "dotenv -e .env.testnet -- env MARKET_SYNC_SCOPE=pons pnpm --filter @zkblast/indexer run sync:external-markets",
    "markets:sync:swaps:testnet": "dotenv -e .env.testnet -- pnpm --filter @zkblast/indexer run sync:external-market-swaps",
    "markets:sync:oracles:testnet": "dotenv -e .env.testnet -- pnpm --filter @zkblast/indexer run sync:external-market-oracles",
    "markets:curation:export:testnet": "dotenv -e .env.testnet -- env MARKET_CURATION_FILE=../../data/market-curation.testnet.json pnpm --filter @zkblast/indexer run markets:curate export",
    "markets:curation:apply:testnet": "dotenv -e .env.testnet -- env MARKET_CURATION_FILE=../../data/market-curation.testnet.json pnpm --filter @zkblast/indexer run markets:curate apply",
    "markets:curation:validate:testnet": "dotenv -e .env.testnet -- env MARKET_CURATION_FILE=../../data/market-curation.testnet.json pnpm --filter @zkblast/indexer run markets:curate:validate",
    "markets:sync:pairs:testnet": "dotenv -e .env.testnet -- pnpm --filter @zkblast/indexer run sync:external-market-pairs",
    "markets:map:tokens:testnet": "dotenv -e .env.testnet -- env TESTNET_MARKET_MAPPING_FILE=../../data/testnet-market-mappings.json pnpm --filter @zkblast/indexer run map:testnet-market-tokens",
    "markets:discover:routes:testnet": "dotenv -e .env.testnet -- pnpm --filter @zkblast/indexer run discover:testnet-market-routes",
    "markets:seed:pools:testnet": "dotenv -e .env.testnet -- pnpm --filter @zkblast/contracts run seed:testnet-external-markets",
    "check:db:migrations": "node scripts/check-database-migrations.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "postgres": "^3.4.5",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
