# HyperEVM mainnet (chain 999). This template is not a deployment approval.
APP_ENV=mainnet
CHAIN_ID=999
CHAIN_NAME=HyperEVM
RPC_URL=https://rpc.hyperliquid.xyz/evm
# Optional comma-separated server-only fallbacks. Validate each provider before enabling.
RPC_FALLBACK_URLS=
# The official RPC currently has no WebSocket JSON-RPC support.
WS_RPC_URL=
BLOCK_EXPLORER_URL=https://www.hyperscan.com
DEPLOYMENT_MANIFEST_PATH=deployments/hyperevm-mainnet/manifest.json
API_PORT=3001
WEB_ORIGIN=
ROBINHOOD_MAINNET_WEB_URL=https://zkblast.tech
HYPEREVM_MAINNET_WEB_URL=
ENABLE_HYPEREVM_MAINNET=true
HYPEREVM_MAINNET_RPC_URL=https://rpc.hyperliquid.xyz/evm
INDEXER_CONFIRMATIONS=
INDEXER_POLL_INTERVAL_MS=1000
INDEXER_BATCH_SIZE=20
INDEXER_CATCHUP_CHUNK_SIZE=50
INDEXER_RPC_RANGE_DELAY_MS=500
ALERT_RPC_LAG_BLOCKS=12
ALERT_CHECKPOINT_AGE_SECONDS=60
ALERT_TRANSACTION_FAILURES=2
ALERT_RECEIPT_FAILURES=3
OPERATIONS_API_TOKEN=
LAUNCHPAD_WEBHOOK_ENCRYPTION_KEY=

# Browser-safe values only.
NEXT_PUBLIC_API_URL=
API_URL=

# Use a distinct HyperEVM project/schema. Never reuse Robinhood schemas.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DIRECT_DATABASE_URL=
SUPABASE_SCHEMA=zkblast_hyperevm_mainnet

# Server-side signing values remain private. Public role addresses below follow the verified manifest.
DEPLOYER_PRIVATE_KEY=
GOVERNANCE_PRIVATE_KEY=
UPGRADER_PRIVATE_KEY=
HYPEREVM_DEPLOYER_ADDRESS=0xB5C0eD0252d1906Fca50664Eb2198Aea0679920B
GOVERNANCE_MULTISIG_ADDRESS=0xB5C0eD0252d1906Fca50664Eb2198Aea0679920B
HYPEREVM_UPGRADER_ADDRESS=0x54Ad8502759C61596c428054660674E0ec919F10
HYPEREVM_KEEPER_ADDRESS=
HYPEREVM_RELAYER_ADDRESS=
HYPEREVM_FEE_RECIPIENT_ADDRESS=
MIN_TIMELOCK_DELAY_SECONDS=300

# Canonical WHYPE reserve asset used by the approved chain-999 DBC template.
HYPEREVM_RESERVE_ASSET_ADDRESS=0x5555555555555555555555555555555555555555

# Verified chain-999 integration addresses. These are public contract addresses, not secrets.
EXECUTION_RESERVE_ASSET_ADDRESS=0x5555555555555555555555555555555555555555
GRADUATION_POOL_FACTORY_ADDRESS=0x4f967Beb4929CCF6F4D323669ce83074b8238439
GRADUATION_SWAP_ROUTER_ADDRESS=0x6ba114EbBC04A0b774B366CeDD4BE90506122e5c
